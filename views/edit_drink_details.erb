<p>Just Testing</p>


<form action="/update-drink-details" method="post">
  <div style='text-align: center;'>
      <button class="change-btn" type="button" onclick="togglePriceEdit(this)">Change Details</button> <br><br>
  </div>

  <div class="catalog-grid" id="item-container">
    <% @drinks.each do |drink| %>
      <div class="product-card" data-beverage="<%= drink.beverage %>">
        <%
          rel_path = "drinks/#{drink.beverage}.png"
          if File.exist?(File.join(Dir.pwd, "public", rel_path))
            display_path = "/#{rel_path}"
          else
            display_path = "/drinks/drink_img_not_found.png"
          end
        %>
      
        <img src="<%= display_path %>" alt="<%= drink.beverage %>">
        <h3><%= drink.beverage %></h3>
        <p class="price">£<%= sprintf('%.2f', drink.regular_price) %> (Regular size)</p>
        <label for="price-<%= drink.id %>" style="display:none;">Price (Regular size): £</label>
        <input type="number" name="prices[<%= drink.id %>]" id="price-<%= drink.id %>" value="<%= sprintf('%.2f', drink.regular_price) %>" step="0.1" min="0" placeholder="Enter price" style="display:none;">

      </div>
          
    <% end %>
  </div>
</form>

<script>
  function togglePriceEdit(btn) {
    const labels = document.querySelectorAll('label[for^="price-"]');
    const inputs = document.querySelectorAll('input[id^="price-"]');
    const prices = document.querySelectorAll('p.price');
    
    if (inputs[0].style.display === 'none') {
      labels.forEach(label => label.style.display = 'inline');
      inputs.forEach(input => input.style.display = 'inline-block');
      prices.forEach(price => price.style.display = 'none');
      btn.textContent = 'Save';
    } else {
      document.querySelector('form').submit();
    }
  }
</script>