<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Support</title>
    <link rel="styesheet" href="public/style.css">
    <link rel="icon" type="image/x-icon" href="coffee.png">
</head>

<body>
    <div class="form-field">
        <div class="redirect">
            <a href="/..">Home / </a> <span>Help</span>
        </div>
        <form method="post" action="/help">
            <div class="box_size">
                <label for="form_username">Your name</label>
                <input type="text" id="form_username" name="form_username"/>
            </div>
            
            <div class="box_size">
                <label for="form_useremail">Your email address</label>
                <input type="text" id= "form_useremail" name="form_useremail"/>
            </div> <br>

            <label for="problem_type"> &nbsp; Problem type</label>
            <select name="problem_type" id="problem_type" class="problem_box">
                <option value="query">Query</option>
                <option value="technical">Technical</option>
                <option value="complaint">Complaint</option>
                <option value="other">Other</option>
            </select> <br><br>

            <div class="description_box">
                <label for="form_request_description">Request Description</label>
                <input type="text" id="form_request_description" name="form_request_description" class="description_box"/>
            </div> <br><br>
            
            <input type="submit" value="Submit" class="submit_button"/>
        </form>
    </div>
</body>

</html>

