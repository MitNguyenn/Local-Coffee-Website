<h1 class="discount-page-title">Manage Store Discounts</h1>

<div class="discount-item discount-create-card" style="border: 2px dashed #444; margin-bottom: 2rem; background: #fafafa;">
  <h3 style="margin: 0 0 1rem 0; color: #222; font-size: 1.1rem; font-weight: 600;">Create New Discount</h3>
  
  <form action="/create-discount" method="POST" class="discount-form">
    <div class="discount-field-group">
      <div class="discount-input-wrapper">
        <label class="discount-label">Discount Name</label>
        <input type="text" name="discount_name" placeholder="e.g., Student Discount" class="discount-input" required>
      </div>

      <div class="discount-input-wrapper">
        <label class="discount-label">Multiplier (e.g., 0.90 for 10% off)</label>
        <input type="number" name="discount_mult" placeholder="1.00" step="0.01" min="0.00" max="1.50" class="discount-input" required>
      </div>
    </div>

    <button type="submit" class="discount-update-btn" style="background-color: #222;">Create Discount</button>
  </form>
</div>

<div class="discount-list">
  <% if @discounts.empty? %>
    <p>No promotional discounts configured in the database.</p>
  <% else %>
    <% @discounts.each do |name, data| %>
      <!-- FIX: Attached a unique database ID attribute wrapper to eliminate ambiguous sibling form states -->
      <div class="discount-item" id="discount-row-<%= data[:id] %>">
        <form action="/update-discount" method="POST" class="discount-form">
          <input type="hidden" name="discount_id" value="<%= data[:id] %>">
          <div class="discount-field-group">
            <div class="discount-input-wrapper">
              <label class="discount-label">Discount Name</label>
              <input type="text" name="discount_name" value="<%= name %>" class="discount-input" required>
            </div>
            <div class="discount-input-wrapper">
              <label class="discount-label">Multiplier</label>
              <input type="number" name="discount_mult" value="<%= data[:multiplier] %>" step="0.01" min="0.00" max="1.50" class="discount-input" required>
            </div>
          </div>
          <div class="discount-actions-group" style="display: flex; gap: 10px; margin-top: 0.5rem;">
            <button type="submit" class="discount-update-btn">Save Changes</button>
        </form>
        <form action="/delete-discount" method="POST" onsubmit="return confirm('Are you sure?');">
          <input type="hidden" name="discount_id" value="<%= data[:id] %>">
          <button type="submit" class="discount-delete-btn" id="deletediscount-<%= data[:id] %>">Delete</button>
        </form>
        </div>
      </div>
    <% end %>
  <% end %>
</div>