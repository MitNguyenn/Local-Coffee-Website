<h1 class="portal-box-title">Staff Portal</h1>

<div class="portal-box-container">
  <% if ["administrator", "manager", "barista"].include?(session[:account_type]) %>
    <!-- Everyone items -->
    <a href="/order-management-barista" class="portal-box">
      <h1 class="portal-title">Order Management</h1>
    </a>
    <a href="/manage-loyalty-cards" class="portal-box">
      <h1 class="portal-title">Loyalty Cards</h1>
    </a>
    <a href="/user-tickets" class="portal-box">
      <h1 class="portal-title">User Tickets</h1>
    </a>
    <a href="/refund-tickets" class="portal-box">
      <h1 class="portal-title">Refunds</h1>
    </a>
    <a href="/daily-summary" class="portal-box">
      <h1 class="portal-title">Daily Summary</h1>
    </a>
  <% end %>

  <% if ["administrator", "manager"].include?(session[:account_type]) %>
    <!-- Manager and Administrator items -->
    <a href="/metrics" class="portal-box">
      <h1 class="portal-title">Metrics</h1>
    </a>
    <a href="/stock-management" class="portal-box">
      <h1 class="portal-title">Stock Management</h1>
    </a>
    <a href="/manage-discounts" class="portal-box">
      <h1 class="portal-title">Discount Management</h1>
    </a>
    <a href="/bean-stock-management" class="portal-box">
      <h1 class="portal-title">Bean Stocks</h1>
    </a>
  <% end %>

  <% if session[:account_type] == "administrator" %>
    <!-- Administrator only items -->
    <a href="/manage-accounts" class="portal-box">
      <h1 class="portal-title">Manage User Accounts</h1>
    </a>
    <a href="/employee-accounts" class="portal-box">
      <h1 class="portal-title">Manage Employee Accounts</h1>
    </a>
    <a href="/flagged-accounts" class="portal-box">
      <h1 class="portal-title">Flagged Accounts</h1>
    </a>
    <a href="/order-management/administrator" class="portal-box">
      <h1 class="portal-title">Manage Orders</h1>
    </a>
  <% end %>
</div>