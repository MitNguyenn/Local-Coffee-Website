<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Badly Brewed Coffee</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/x-icon" href="coffee.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lilita+One&display=swap" rel="stylesheet">
  <link
    href="https://fonts.googleapis.com/css2?family=Datatype:wght@100..900&family=Doto:wght@100..900&family=Lilita+One&display=swap"
    rel="stylesheet">
</head>

<body>
  <nav class="navbar">
    <div class="nav-left-group">
      <div class="home-btn">
        <a href="/"><img src="/home.png" width="40" height="40"></a>
      </div>

      <div class="dropdown">
        <div onclick="toggleDropdown(event)" class="menu-icon">☰</div>

        <div id="myDropdown" class="dropdown-content">
          <a href="/">Home</a>
          <a href="/coffee-beans">Coffee Beans</a>
          <a href="/drinks">Drinks</a>
          <a href="/staff-portal">Staff Portal</a>
          <a href="/help">Help</a>
        </div>
      </div>
    </div>
    <div class="nav-right">

      <!-- Basket Button -->
      <div onclick="toggleDropdownCart(event)" class="cart">
        <img src="/basket.png" alt="basket-icon" width="50" height="50">
        
        <% if session[:basket] && session[:basket].any? %>
          <span class="cart-dot" id="basket-indicator"></span>
        <% end %>
      </div>

      <!-- Account Button -->
      <div class="dropdown">
        <div onclick="toggleDropdownUser(event)" class="user-icon">
          <img src="/msn_profile.png" width="60" height="60">
        </div>
        <div id="userDropdown" class="user-dropdown-content">
          <% if !logged_in? %>
            <a href="/log-in">Log in</a>
          <% end %>

          <% if logged_in? %>
            <a href="/account-settings">Account settings</a>
            <a href="/loyalty-card">Loyalty Card</a>
            <a href="/my-orders">My Orders</a>
            <a href="/log-out">Log out</a>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <main>
    <%= yield %>
  </main>

  <footer>
    <p>&copy; 2026 Badly Brewed Coffee - Team 35</p>
  </footer>

  <script>
    function closeAllDropdowns() {
      const dropdowns = [
        document.getElementById("myDropdown"),
        document.getElementById("userDropdown")
      ];

      dropdowns.forEach(menu => {
        if (menu) menu.classList.remove("show");
      });
    }

    function toggleDropdown(event) {
      event.preventDefault();
      event.stopPropagation();

      const menu = document.getElementById("myDropdown");
      const isShowing = menu.classList.contains("show");

      closeAllDropdowns();

      if (!isShowing) {
        menu.classList.add("show");
      }
    }

    function toggleDropdownCart(event) {
      event.stopPropagation();
      window.location.href = `/basket`;
    }

    function toggleDropdownUser(event) {
      event.stopPropagation();
      const menu = document.getElementById("userDropdown");
      const isShowing = menu.classList.contains("show");
      closeAllDropdowns();
      if (!isShowing) menu.classList.add("show");
    }

    window.onclick = function (event) {
      closeAllDropdowns();
    }

    function updateBasketUI(newCount) {
      let countSpan = document.getElementById("basket-count");
      if (!countSpan) {
        const cartDiv = document.querySelector(".cart");
        countSpan = document.createElement("span");
        countSpan.id = "basket-count";
        countSpan.className = "cart-count";
        cartDiv.appendChild(countSpan);
      }
      countSpan.innerText = newCount;
    }

  </script>
</body>

</html>
