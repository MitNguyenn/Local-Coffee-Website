<div class="order-stats">
  <div class="stats-grid">
    
    <!-- Loyalty Tracker Box -->
    <div class="stats-card">
      <h4 class="stats-card__label">Loyalty Progress</h4>
      <div class="stamp-tracker">
        <% 10.times do |i| %>
          <span class="stamp-slot <%= 'stamp-slot--filled' if i < @stats['stamp_count'] %>"></span>
        <% end %>
      </div>
      <p class="stats-card__subtext" style="color: #444;">
        <strong><%= @stats['until_next_discount'] %></strong> stamps until your next free drink!
      </p>
    </div>

    <!-- Drinks Metric Box -->
    <div class="stats-card">
      <h4 class="stats-card__label">Drinks Ordered</h4>
      <p class="stats-card__value"><%= @stats['total_num_coffee'] %></p>
      <span class="stats-card__subtext">Total beverages purchased</span>
    </div>

    <!-- Bean Bag Metric Box -->
    <div class="stats-card">
      <h4 class="stats-card__label">Coffee Bags</h4>
      <p class="stats-card__value"><%= @stats['total_num_beans'] %></p>
      <span class="stats-card__subtext">Whole bean retail packs</span>
    </div>

  </div>
</div>

  <div class="my-orders-nav">
    <button class="my-orders-nav-btn active" id="btn-live" onclick="showTab('live')">Live Orders</button>
    <button class="my-orders-nav-btn" id="btn-past" onclick="showTab('past')">Order History</button>
  </div>

  <!-- LIVE ORDERS -->
  <div id="view-live" class="my-orders-section active">
    <% if @current_orders.empty? %>
      <p>No active orders at the moment.</p>
    <% else %>
      <% # Group flat rows into logical orders by order_id %>
      <% @current_orders.group_by { |o| o[:order_id] }.each do |order_id, items| %>
        <% first_row = items.first %>
        <div class="my-orders-card">
          <div class="my-orders-header">
            <span class="my-orders-title">Order #<%= order_id %></span>
            <span class="my-orders-date"><%= first_row[:created_at].strftime("%H:%M") %></span>
          </div>
          <div class="my-orders-grid">
            <div>
              <ul class="my-orders-items">
                <% items.each do |item| %>
                  <li>
                    <strong><%= item[:quantity] %>x</strong> 
                    <%= item[:item_id] %>
                    <%= " (#{item[:size]})" if item[:size] %>
                    <%= " - #{item[:roast_level]} Roast" if item[:roast_level] %>
                    <%= " [#{item[:milk]} milk]" if item[:milk] %>
                  </li>
                <% end %>
              </ul>
            </div>
            <div>
              <strong>Total:</strong> £<%= '%.2f' % first_row[:total_cost] %>
              <br>
              <strong>Order collected/received: <%= if first_row[:order_is_completed] then "Yes" else "No" end %></strong> 
              <br>
              <div>
                <strong>Payment status:</strong>
                <span class="my-orders-badge"><%= if first_row[:payment_is_completed] then "Paid" else "Not paid" end %></span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- PAST ORDERS -->
  <div id="view-past" class="my-orders-section">
    <% if @past_orders.empty? %>
      <p>Your order history is empty.</p>
    <% else %>
      <% # Group flat rows into logical orders by order_id %>
      <% @past_orders.group_by { |o| o[:order_id] }.each do |order_id, items| %>
        <% first_row = items.first %>
        <div class="my-orders-card" style="border-color: #eee; opacity: 0.9;">
          <div class="my-orders-header">
            <span class="my-orders-title">Order #<%= order_id %></span>
            <span class="my-orders-date"><%= first_row[:created_at].strftime("%d %b %Y") %></span>
          </div>
          <div class="my-orders-grid">
            <div>
              <ul class="my-orders-items">
                <% items.each do |item| %>
                  <li>
                    <strong><%= item[:quantity] %>x</strong> 
                    <%= item[:item_id] %>
                    <%= " (#{item[:size]})" if item[:size] %>
                    <%= " - #{item[:roast_level]} Roast" if item[:roast_level] %>
                  </li>
                <% end %>
              </ul>
            </div>
            <div>
              <strong>Total:</strong> £<%= '%.2f' % first_row[:total_cost] %><br>
              <span class="my-orders-badge">Completed</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
function showTab(type) {
  // Toggle Views
  document.querySelectorAll('.my-orders-section').forEach(s => s.classList.remove('active'));
  document.getElementById('view-' + type).classList.add('active');
  
  // Toggle Buttons
  document.querySelectorAll('.my-orders-nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('btn-' + type).classList.add('active');
}
</script>