<div class="product-detail-container">
  <h1 id="origin" data-origin="<%= @item.Origin %>"><%= @item.Origin %></h1>

  <div class="product-main-content"> 
    <%
      rel_path = "beans/#{@item.Origin}.png"
      
      if File.exist?(File.join(Dir.pwd, "public", rel_path))
        display_path = "/#{rel_path}"
      else
        display_path = "/beans/beans_img_not_found.png"
      end
    %>
    <img src="<%= display_path %>" alt="<%= @item.Origin %>" width="500" height="500">

    <div class="product-details">
      <span id="base-price" data-price="<%= @item.PricePer250g %>" style="display:none;"></span>
      <label for="pack-weight-select">Select Size:</label>
      <select name="pack-weight" id="pack-weight-select">
        <% @bean_packs.each do | pack | %>
          <option value="<%= pack[:PackWeight] %>" data-multiplier="<%= pack[:MarkupMultiplier] %>">
            <%= pack[:PackWeight] %>g
          </option>
        <% end %>
      </select>

      <label for="roast-level-select"><b>Roast levels:</b></label>
      <select name="roast-level" id="roast-level-select">
        <% @bean_roast_levels.each do | roast | %>
          <option value="<%= roast[:RoastLevel] %>"><%= roast[:RoastLevel] %></option>
        <% end %>
      </select>

      <h2 id="display-price">Total price: £<%= sprintf("%.2f", @item.PricePer250g) %></h2>
      <button onclick="addToCartOnClick(event)" id="add-to-cart-button" class="add-to-cart-button">Add to cart</button>
    </div>
  </div>
</div> <a href="/coffee-beans" class="back-link">Back to Catalog</a>

<script>
  const origin = document.getElementById('origin').dataset.origin;

  const basePriceValue = parseFloat(document.getElementById('base-price').dataset.price);
  const displayPrice = document.getElementById('display-price');

  const weightSelect = document.getElementById('pack-weight-select');

  function getPrice() {
    const packWeightSelect = weightSelect.options[weightSelect.selectedIndex];
    const multiplier = parseFloat(packWeightSelect.dataset.multiplier);
    return basePriceValue * multiplier;
  }

  function updatePrice() {
    newPrice = getPrice();
    displayPrice.innerText = 'Total price: £' + roundToTwoDecimalPlaces(newPrice);
  }

  weightSelect.addEventListener('change', updatePrice);

  function addToCartOnClick(event) {
    const packWeight = document.getElementById('pack-weight-select').value;
    const roastLevel = document.getElementById('roast-level-select').value;
    const price = getPrice();

    fetch('/add-to-cart', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `item_type=bean&origin=${origin}&pack_weight=${packWeight}&roast_level=${roastLevel}&price=${price}`
    })
    .then(data => {
      const indicator = document.getElementById('cart-indicator');
      if (indicator) {
        indicator.classList.remove('hidden');
      }
      
      const button = document.getElementById('add-to-cart-button');
      button.textContent = "Added! ✅";
      setTimeout(() => { button.textContent = "Add to cart"; }, 1000);
    });
  }
</script>