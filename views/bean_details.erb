<div class="product-detail-container">
  <h1 id="origin" data-origin="<%= @item.origin %>"><%= @item.origin %></h1>

  <div class="product-main-content"> 
    <%
      rel_path = "beans/#{@item.origin}.png"
      
      if File.exist?(File.join(Dir.pwd, "public", rel_path))
        display_path = "/#{rel_path}"
      else
        display_path = "/beans/beans_img_not_found.png"
      end
    %>
    <img src="<%= display_path %>" alt="<%= @item.origin %>" width="500" height="500">

    <div class="product-details">
      <span id="base-price" data-price="<%= @item.price_per_250g %>" style="display:none;"></span>
      <label for="pack-weight-select">Select size:</label>
      <select name="pack-weight" id="pack-weight-select">
        <% @bean_packs.each do | pack | %>
          <option value="<%= pack[:pack_weight] %>" data-multiplier="<%= pack[:markup_multiplier] %>">
            <%= pack[:pack_weight] %>g
          </option>
        <% end %>
      </select>

      <label for="roast-level-select"><b>Roast levels:</b></label>
      <select name="roast-level" id="roast-level-select">
        <% @bean_roast_levels.each do | roast | %>
          <option value="<%= roast[:roast_level] %>"><%= roast[:roast_level] %></option>
        <% end %>
      </select>

      <h2 id="display-price">Total price: £<%= sprintf("%.2f", @item.price_per_250g) %></h2>
      <button onclick="toggleFavourite(event)" id="favourite-button" class="fav-btn">Add to Favourites</button>
      <button onclick="addToCartOnClick(event)" id="add-to-cart-button" class="add-to-cart-button">Add to cart</button>
    </div>
  </div>
</div> <a href="/coffee-beans" class="back-link">Back to Catalog</a>

<script>
  const origin = document.getElementById('origin').dataset.origin;
  const loggedIn = <%= logged_in? ? 'true' : 'false' %>;

  const basePriceValue = parseFloat(document.getElementById('base-price').dataset.price);
  const displayPrice = document.getElementById('display-price');

  const weightSelect = document.getElementById('pack-weight-select');
  const roastSelect = document.getElementById('roast-level-select');
  const favouriteButton = document.getElementById('favourite-button');
  const favouriteVariations = <%= @favourite_variations.map { |f| "#{f[:pack_weight]}_#{f[:roast_level]}" }.to_json %>;

  function selectedVariationKey() {
    return `${weightSelect.value}_${roastSelect.value}`;
  }

  function updateFavouriteButton() {
    if (!favouriteButton) return;
    favouriteButton.textContent = favouriteVariations.includes(selectedVariationKey()) ? 'Favourited' : 'Add to Favourites';
  }

  function getPrice() {
    const packWeightSelect = weightSelect.options[weightSelect.selectedIndex];
    const multiplier = parseFloat(packWeightSelect.dataset.multiplier);
    return basePriceValue * multiplier;
  }

  function updatePrice() {
    newPrice = getPrice();
    updateFavouriteButton();
    displayPrice.innerText = 'Total price: £' + roundToTwoDecimalPlaces(newPrice);
  }

  weightSelect.addEventListener('change', updatePrice);
  roastSelect.addEventListener('change', updateFavouriteButton);
  updateFavouriteButton();

  function toggleFavourite(event) {
    if (!loggedIn) {
      window.location.href = '/log-in';
      return;
    }

    const packWeight = weightSelect.value;
    const roastLevel = roastSelect.value;

    fetch('/toggle-favourite-bean', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `origin=${encodeURIComponent(origin)}&pack_weight=${encodeURIComponent(packWeight)}&roast_level=${encodeURIComponent(roastLevel)}`
    })
    .then(response => response.json())
    .then(data => {
      const key = selectedVariationKey();
      if (data.favourited && !favouriteVariations.includes(key)) {
        favouriteVariations.push(key);
      } else if (!data.favourited) {
        const index = favouriteVariations.indexOf(key);
        if (index >= 0) favouriteVariations.splice(index, 1);
      }
      updateFavouriteButton();
    });
  }

  function addToCartOnClick(event) {
    const packWeight = document.getElementById('pack-weight-select').value;
    const roastLevel = document.getElementById('roast-level-select').value;
    const price = getPrice();

    fetch('/add-to-cart', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `item_type=bean&origin=${origin}&pack_weight=${packWeight}&roast_level=${roastLevel}&price=${price}`
    })
    .then(data => {
      const indicator = document.getElementById('cart-indicator');
      if (indicator) {
        indicator.classList.remove('hidden');
      }
      
      const button = document.getElementById('add-to-cart-button');
      button.textContent = "Added! ✅";
      setTimeout(() => { button.textContent = "Add to cart"; }, 1000);
    });
  }
</script>