<div class="checkout-container">
  <div class="checkout-form-section">
    <h2>Shipping & Payment</h2>
    <form id="checkout-form" action="/place-order" method="POST">
      
      <div class="form-group">
        <h3>Shipping Address</h3>
        <input type="text" name="Name" placeholder="Name" required value="<%= @user ? @user[:FirstName] + ' ' + @user[:LastName] : '' %>">
        <input type="text" name="address" placeholder="Address" required value="<%= @user ? @user[:Address] : '' %>">
        <input type="text" name="postcode" placeholder="Postcode" required value="<%= @user ? @user[:Postcode] : '' %>">
      </div>

      <div class="form-group">
        <h3>Card Details</h3>
        <div class="fake-card-input">
          <input type="text" placeholder="Card Number (16 digits)" maxlength="16">
          <div class="card-extra">
            <input type="text" placeholder="MM/YY" maxlength="5">
            <input type="text" placeholder="CVV" maxlength="3">
          </div>
        </div>
      </div>
    </form>
  </div>

  <div class="checkout-summary-section">
    <div class="summary-glass-card">
      <h3>Order Summary</h3>
      <div class="summary-line">
  <span>Subtotal</span>
  <span>£<%= sprintf('%.2f', @subtotal) %></span>
</div>

<div class="summary-line">
  <span>Shipping</span>
  <span>£3.50</span>
</div>

<hr>

<div class="summary-line total">
  <span>Total</span>
  <span>£<%= sprintf('%.2f', @subtotal + 3.50) %></span>
</div>

      <button type="submit" form="checkout-form" class="purchase-btn">
        Place Order
      </button>
    </div>
  </div>
</div>