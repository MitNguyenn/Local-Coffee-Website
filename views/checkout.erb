<div class="checkout-container">
  <div class="checkout-form-section">
    <h2>Shipping & Payment</h2>
    <form id="checkout-form" action="/place-order" method="POST">
      
      <%# Hidden fields for Instant Checkout logic %>
      <% if @is_instant %>
        <input type="hidden" name="instant_id" value="<%= @instant_id %>">
        <input type="hidden" name="instant_type" value="<%= @instant_type %>">
      <% end %>

      <div class="form-group">
        <h3>Shipping Address</h3>
        <input type="text" name="address" placeholder="Address" required value="<%= @user[:Address] if @user %>"> [cite: 32]
        <input type="text" name="postcode" placeholder="Postcode" required value="<%= @user[:Postcode] if @user %>"> [cite: 32]
      </div>

      <div class="form-group">
        <h3>Card Details</h3>
        <div class="fake-card-input">
          <input type="text" placeholder="Card Number (16 digits)" maxlength="16"> [cite: 33]
          <div class="card-extra">
            <input type="text" placeholder="MM/YY" maxlength="5"> [cite: 33]
            <input type="text" placeholder="CVV" maxlength="3"> [cite: 33]
          </div>
        </div>
      </div>
    </form>
  </div>

  <div class="checkout-summary-section">
    <div class="summary-glass-card">
      <h3>Order Summary</h3> [cite: 34]
      
      <div class="summary-items">
        <% @basket_items.each do |item| %>
          <div class="summary-line item-detail">
            <%# Check if it's a Drink (Beverage) or Bean (Name) %>
            <span><%= item.respond_to?(:Beverage) ? item.Beverage : item.Name %></span>
            <span>£<%= sprintf('%.2f', item.Price) %></span>
          </div>
        <% end %>
      </div>

      <hr>

      <div class="summary-line">
        <span>Subtotal</span>
        <span>£<%= sprintf('%.2f', @subtotal) %></span> [cite: 34]
      </div>

      <div class="summary-line">
        <span>Shipping</span>
        <span>£3.50</span> [cite: 34]
      </div>

      <div class="summary-line total">
        <span>Total</span>
        <span>£<%= sprintf('%.2f', @subtotal + 3.50) %></span> [cite: 34]
      </div>

      <button type="submit" form="checkout-form" class="purchase-btn">
        Place Order
      </button> [cite: 34]
    </div>
  </div>
</div>