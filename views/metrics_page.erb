<div class="m-dash-wrapper">
  <header class="m-dash-header">
    <h1 class="m-dash-header__title">Managerial Analytics</h1>
  </header>

  <!-- Hero Stats Grid -->
  <div class="m-dash-grid m-dash-grid--hero">
    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Gross Revenue</h3>
      <p class="m-dash-card__value">£<%= sprintf('%.2f', @metrics[:total_sales]) %></p>
    </div>
    
    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Avg. Order Value</h3>
      <p class="m-dash-card__value">£<%= sprintf('%.2f', @metrics[:avg_order_value]) %></p>
    </div>

    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Top 3 Ranking</h3>
      <div class="m-dash-ranking">
        <% if @metrics[:top_products].any? %>
          <% @metrics[:top_products].each_with_index do |(name, qty), index| %>
            <div class="m-dash-ranking__row">
              <span class="m-dash-ranking__index">#<%= index + 1 %></span>
              <span class="m-dash-ranking__name"><%= name %></span>
              <span class="m-dash-ranking__qty"><%= qty %> sold</span>
            </div>
          <% end %>
        <% else %>
          <p class="m-dash-ranking__empty">No sales data found.</p>
        <% end %>
      </div>
    </div>

    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Total Account Holders</h3>
      <p class="m-dash-card__value"><%= @metrics[:total_accounts] %></p>
    </div>

    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Monthly Sign-up Change</h3>
      <div class="m-dash-signup-change">
        <% if @metrics[:monthly_signups_change].any? %>
          <% latest_month = @metrics[:monthly_signups_change].keys.last %>
          <% latest_data = @metrics[:monthly_signups_change][latest_month] %>
          <p class="m-dash-card__value"><%= latest_data[:change] >= 0 ? '+' : '' %><%= latest_data[:change] %></p>
          <p class="m-dash-card__subtitle"><%= latest_month %>: <%= latest_data[:signups] %> total</p>
        <% else %>
          <p class="m-dash-card__value">N/A</p>
          <p class="m-dash-card__subtitle">No data available</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Detail Split View -->
  <div class="m-dash-grid m-dash-grid--split">
    <section class="m-dash-panel">
      <h2 class="m-dash-panel__title">Sales by Channel</h2>
      <table class="m-dash-table">
        <% @metrics[:sales_by_category].each do |type, total| %>
          <tr>
            <td><%= type || "General" %></td>
            <td class="m-dash-table__price">£<%= sprintf('%.2f', total) %></td>
          </tr>
        <% end %>
      </table>
    </section>

    <section class="m-dash-panel">
      <h2 class="m-dash-panel__title">Monthly Revenue</h2>
      <table class="m-dash-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% @metrics[:monthly_sales].each do |month, total| %>
            <tr>
              <td><%= month %></td>
              <td class="m-dash-table__price">£<%= sprintf('%.2f', total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>

    <section class="m-dash-panel">
      <h2 class="m-dash-panel__title">Monthly Account Sign-ups</h2>
      <table class="m-dash-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Sign-ups</th>
            <th>Change</th>
          </tr>
        </thead>
        <tbody>
          <% @metrics[:monthly_signups_change].each do |month, data| %>
            <tr>
              <td><%= month %></td>
              <td><%= data[:signups] %></td>
              <td class="<%= data[:change] >= 0 ? 'positive-change' : 'negative-change' %>">
                <%= data[:change] >= 0 ? '+' : '' %><%= data[:change] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </div>
</div>

<button id="download-btn" class="m-download-btn" data-metrics='<%= @metrics.to_json %>'>
  Download Data As CSV
</button>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const btn = document.getElementById('download-btn');
  
  if (btn) {
    btn.addEventListener('click', function() {
      // 1. Get the data from the attribute safely
      const rawData = this.getAttribute('data-metrics');
      const metrics = JSON.parse(rawData);
      
      // 2. Build the CSV rows
      const rows = [];
      const safeFix = (val) => parseFloat(val || 0).toFixed(2);

      // Financials
      rows.push(["Category", "Label/Name", "Value"]);
      rows.push(["Financials", "Gross Revenue", `£${safeFix(metrics.total_sales)}`]);
      rows.push(["Financials", "Avg. Order Value", `£${safeFix(metrics.avg_order_value)}`]);
      rows.push(["Financials", "Total Account Holders", metrics.total_accounts]);
      rows.push([]);

      // Top Products
      rows.push(["Top 3 Ranking", "Product Name", "Qty Sold"]);
      (metrics.top_products || []).forEach((item, index) => {
        // item[0] is name, item[1] is qty
        rows.push([`Rank #${index + 1}`, item[0], item[1]]);
      });
      rows.push([]);

      // Sales by Channel
      rows.push(["Sales by Channel", "Type", "Total"]);
      Object.entries(metrics.sales_by_category || {}).forEach(([type, total]) => {
        rows.push(["Channel", type || "General", `£${safeFix(total)}`]);
      });
      rows.push([]);

      // Monthly Timeline
      rows.push(["Monthly Revenue", "Month", "Total"]);
      Object.entries(metrics.monthly_sales || {}).forEach(([month, total]) => {
        rows.push(["Monthly", month, `£${safeFix(total)}`]);
      });
      rows.push([]);

      // Monthly Account Sign-ups
      rows.push(["Monthly Account Sign-ups", "Month", "Sign-ups", "Change"]);
      Object.entries(metrics.monthly_signups_change || {}).forEach(([month, data]) => {
        rows.push(["Sign-ups", month, data.signups, data.change]);
      });

      // 3. Generate and Download
      const csvContent = rows
        .map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(","))
        .join("\n");

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = `Analytics_Export_${new Date().toISOString().slice(0,10)}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });
  }
});
</script>
