<div class="m-dash-wrapper">
  <header class="m-dash-header">
    <h1 class="m-dash-header__title">Managerial Analytics</h1>
  </header>

  <!-- Hero Stats Grid -->
  <div class="m-dash-grid m-dash-grid--hero">
    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Gross Revenue</h3>
      <p class="m-dash-card__value">£<%= sprintf('%.2f', @metrics[:total_sales]) %></p>
    </div>
    
    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Avg. Order Value</h3>
      <p class="m-dash-card__value">£<%= sprintf('%.2f', @metrics[:avg_order_value]) %></p>
    </div>

    <div class="m-dash-card">
      <h3 class="m-dash-card__label">Top 3 Ranking</h3>
      <div class="m-dash-ranking">
        <% if @metrics[:top_products].any? %>
          <% @metrics[:top_products].each_with_index do |(name, qty), index| %>
            <div class="m-dash-ranking__row">
              <span class="m-dash-ranking__index">#<%= index + 1 %></span>
              <span class="m-dash-ranking__name"><%= name %></span>
              <span class="m-dash-ranking__qty"><%= qty %> sold</span>
            </div>
          <% end %>
        <% else %>
          <p class="m-dash-ranking__empty">No sales data found.</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Detail Split View -->
  <div class="m-dash-grid m-dash-grid--split">
    <section class="m-dash-panel">
      <h2 class="m-dash-panel__title">Sales by Channel</h2>
      <table class="m-dash-table">
        <% @metrics[:sales_by_category].each do |type, total| %>
          <tr>
            <td><%= type || "General" %></td>
            <td class="m-dash-table__price">£<%= sprintf('%.2f', total) %></td>
          </tr>
        <% end %>
      </table>
    </section>

    <section class="m-dash-panel">
      <h2 class="m-dash-panel__title">Monthly Revenue</h2>
      <table class="m-dash-table">
        <thead>
          <tr>
            <th>Month</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          <% @metrics[:monthly_sales].each do |month, total| %>
            <tr>
              <td><%= month %></td>
              <td class="m-dash-table__price">£<%= sprintf('%.2f', total) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </div>
</div>

<button class = "m-download-btn" onclick="downloadCSV()">Download CSV</button>