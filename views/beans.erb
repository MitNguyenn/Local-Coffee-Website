<div class="page-title">
    <h2>Our Coffee Beans</h2>
</div>

<div class="catalog-grid" id="item-container">
  <% @beans.each do |bean| %>
    <% if bean.CurrentStock > 0 %>
      <div class="product-card" data-bean-id="<%= bean[:BeanID] %>">
        <%
          rel_path = "beans/#{bean.BeanID}.jpg"
          if File.exist?(File.join(Dir.pwd, "public", rel_path))
            display_path = "/#{rel_path}"
          else
            display_path = "/beans/beans_img_not_found.png"
          end
        %>
        
        <img src="<%= display_path %>" alt="<%= bean.Name %>" width="500" height="500">

        <h3><%= bean.Name %></h3>
        <p>£<%= sprintf('%.2f', bean.Price) %></p>
        
        <button class="add-to-basket-button">Add to basket</button>
        <button class="buy-button">Buy</button>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', eventHandlerBeanPage);
  } else {
    eventHandlerBeanPage();
  }
</script>