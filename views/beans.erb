<div class="page-title">
    <h2>Our Coffee Beans</h2>
</div>

<div class="catalog-grid" id="item-container">
  <% @beans.each do |bean| %>
    <% if bean.CurrentStock > 0 %>
      <div class="product-card" data-bean-id="<%= bean[:BeanID] %>">
        <%
          rel_path = "beans/#{bean.BeanID}.png"
          if File.exist?(File.join(Dir.pwd, "public", rel_path))
            display_path = "/#{rel_path}"
          else
            display_path = "/beans/beans_img_not_found.png"
          end
        %>
        
        <img src="<%= display_path %>" alt="<%= bean.Name %>" width="500" height="500">

        <h3><%= bean.Name %></h3>
        <p>£<%= sprintf('%.2f', bean.Price) %></p>
        
        <button class="add-to-basket-button">Add to basket</button>
        <button class="buy-button">Buy</button>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  const container = document.getElementById('item-container');

  container.addEventListener('click', (event) => {
    const target = event.target;
    const card = target.closest('.product-card');
    
    if (!card) return; 

    const beanId = card.dataset.beanId;

    if (target.classList.contains('add-to-basket-button')) {
      if (target.textContent == "Add to basket") {
        fetch('/add-to-basket', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `id=${beanId}&type=bean`
        })
        .then(response => response.json())
        .then(data => {
          const cartCount = document.getElementById('basket-count');
          if (cartCount) cartCount.textContent = data.count;
          
          target.textContent = "Added! ✅";
          setTimeout(() => { target.textContent = "Remove from basket"; }, 1000);
        });
      } else {
        fetch('/remove-from-basket', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: `id=${beanId}&type=bean`
        })
        .then(response => response.json())
        .then(data => {
          const cartCount = document.getElementById('basket-count');
          if (cartCount) cartCount.textContent = data.count;
          
          target.textContent = "Removed";
          setTimeout(() => { target.textContent = "Add to basket"; }, 1000);
        });
      }
      return; 
    }

    if (target.classList.contains('buy-button')) {
        // Redirect directly to checkout with query parameters
        window.location.href = `/checkout?id=${productId || beanId}&type=bean`;
    }

    if (card) {
      window.location.href = `/product/?type=bean&id=${beanId}`;
    }
  });
</script>