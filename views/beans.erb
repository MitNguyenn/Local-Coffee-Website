<div class="page-title">
    <h2>Our Coffee Beans</h2>
</div>

<div class="catalog-grid" id="item-container">
  <% @beans.each do |bean| %>
    <% if bean[:CurrentStock] > 0 %>
      <div class="product-card" data-bean-id="<%= bean[:BeanID] %>">
        <% 
          specific_image = "/#{bean[:BeanID]}.png"
          image_path = File.exist?("public#{specific_image}") ? specific_image : "/coffee_beans_example.png"
        %>

        <img src="<%= image_path %>" alt="<%= bean[:name] %>">

        <h3><%= bean[:Name] %></h3>
        <p>£<%= sprintf('%.2f', bean[:Price]) %></p>
        <button class="add-to-basket-button">Add to basket</button>
        <button class="buy-button">Buy</button>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  const container = document.getElementById('item-container');

  container.addEventListener('click', (event) => {
    if (event.target.classList.contains('add-to-basket-button')) {
      if (event.target.textContent == "Add to basket") {
        event.target.textContent = "Added! ✅";
        
        // do other stuff (actually add to the basket, update database, ...)
        setTimeout(() => { event.target.textContent = "Remove from basket"; }, 1000);
      } else {
        event.target.textContent = "Removed!";

        // do other stuff (remove from basket, update database, ...)
        setTimeout(() => { event.target.textContent = "Add to basket";}, 1000);
      }
     return; // Stop here so we don't redirect
    }

    const card = event.target.closest('.product-card');

    if (card) {
      const id = card.dataset.beanId;
      window.location.href = `/product/?type=bean&id=${card.dataset.beanId}`;
    }
  });
</script>
