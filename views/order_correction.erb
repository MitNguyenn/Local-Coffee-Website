<% if session[:AccountType] == 'administrator' %>

<table>
    <tr>
        <th>Order ID</th>
        <th>Customer Name</th>
        <th>Order Details</th>
        <th>Correction Reason</th>
        <th>Action</th>
    </tr>
    <% @corrections.each do |correction| %>
        <tr>
        <td><%= correction.order_id %></td>
        <td><%= correction.customer_name %></td>
        <td><%= correction.order_details %></td>
        <td><%= correction.reason %></td>
        <td><a href="/process_correction/<%= correction.id %>">Process Correction</a></td>
        </tr>
    <% end %>
</table>

<% else if session[:AccountType] == 'barista' %>

<% end %>