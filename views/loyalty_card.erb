<main class="login-container">
  <div class="loyalty-card-detailed">
    
    <div class="loyalty-main-info">
      <div class="user-details">
        <p><strong>First Name:</strong><br><%= @user[:first_name]%></p>
        <p><strong>Last Name:</strong><br><%= @user[:last_name]%></p>
        <p><strong>Loyalty Card Number:</strong><br><%= @user[:user_id] %></p>
      </div>
      
      <div class="qr-section">
        <div class="qr-placeholder">
          <%= @qr_svg %>
        </div>
        <p class="qr-label">Scan this QR code in store!</p>
      </div>
    </div>

    <div class="stamps-section">
  <h3>Stamps</h3>
  <div class="stamps-grid">
    <% 10.times do |i| %>
      <div class="stamp <%= 'filled' if @user[:stamp_count] > i %>"></div>
    <% end %>
  </div>
  <p><%= 10 - @user[:stamp_count] %> more until your free coffee!</p>
</div>

    <div class="extra-links">
      <a href="/">Back to Home</a>
    </div>
  </div>
</main>