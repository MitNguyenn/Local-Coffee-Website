<main class="login-container">
  <div class="loyalty-card-detailed">
    
    <div class="loyalty-main-info">
      <div class="user-details">
        <p><strong>First Name:</strong><br><%= @user[:FirstName]%></p>
        <p><strong>Last Name:</strong><br><%= @user[:LastName]%></p>
        <p><strong>Loyalty Card Number:</strong><br><%= @user[:UserID] %></p>
      </div>
      
      <div class="qr-section">
        <div class="qr-placeholder">
          <%= @qr_svg %>
        </div>
        <p class="qr-label">Scan this QR code in store!</p>
      </div>
    </div>

    <div class="stamps-section">
      <h3>Stamps</h3>
      <div class="stamps-grid">
        <!-- to fill a stamp you replace stamp with stamp filled -->
        <div class="stamp filled"></div>
        <div class="stamp filled"></div>
        <div class="stamp filled"></div>
        <div class="stamp"></div>
        <div class="stamp"></div>
        <div class="stamp"></div>
        <div class="stamp"></div>
        <div class="stamp"></div>
        <div class="stamp"></div>
        <div class="stamp"></div>
      </div>
      <p>After 10, the next coffee is on us!</p>
    </div>

    <div class="extra-links">
      <a href="/">Back to Home</a>
    </div>
  </div>
</main>