<table class="stock-mgt-table">
  <thead>
    <tr class="stock-mgt-header">
      <th class="stock-mgt-th">Item</th>
      <th class="stock-mgt-th">Stock Management</th>
    </tr>
  </thead>
  <tbody class="stock-mgt-body">
    <% @beans.each do |bean| %>
      <tr class="stock-mgt-row">
        <td class="stock-mgt-cell stock-mgt-name"><%= bean.Name %></td>
        <td class="stock-mgt-cell">
          <form class="stock-mgt-form" method="post" action="/stock-management">
            <input type="hidden" name="id" value="<%= bean.BeanID %>">
            <input type="hidden" name="type" value="bean">
            <input class="stock-mgt-input" type="number" name="stock" value="<%= bean.CurrentStock %>" min="0">
            <button class="stock-mgt-btn" type="submit">Update</button>
          </form>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
