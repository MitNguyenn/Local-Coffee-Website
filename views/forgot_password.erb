<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Support</title>
    <link rel="styesheet" href="public/style.css">
    <link rel="icon" type="image/x-icon" href="coffee.png">
</head>

<body>
    <div>
        <main class="login-container">
  <div class="login-card">
    <h2>Forgot Password</h2>
    <form method="POST" action="/forgot-password">
      <div class="input-group">
        <label for="email">Email</label>
        <input type="text" id="email" name="email" value="<%= @email %>" placeholder="Enter your email">
      </div>

      <button type="submit" class="login-btn">Send code</button>
    </form>
  </div>
</main>
    </div>
</body>