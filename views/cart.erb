<% if session[:cart] && session[:cart].any? %>
  <% total_cost = 0.0 %>
  <div class="cart-page-content">
    <div class="cart-item-list">
      <% session[:cart].each do | key, data | %>
        <div class="cart-item">
          <span class="cart-item-key"><%= key %></span>
          <div class="cart-item-quantity-controllers">
            <button class="add-button">+</button>
            <span class="cart-item-quantity"> <%= data[:quantity] %></span>
            <button class="remove-button">-</button>
          </div>

        </div>
        <% total_cost += data[:quantity] * data[:price] %>
      <% end %>
    </div>

    <div class="cart-page-checkout-column">
      <h2 id="display-total-cost" data-total-cost="<%= total_cost %>">Total cost: £<%= total_cost%></h2>
      <% if session[:user_id] %>
      <%   @user = DB[:Accounts].where(user_id: session[:user_id]).first %>
          <button onclick="addButtonOnClick(event)" class="checkout-button">Check Out</button>
          <label for="order-delivery-select"><b>Select your delivery option</b></label>
          <select name="delivery-select" id="order-delivery-select">
              <option value="Collect in store" data-address-line="1 Coffee Lane" data-postcode="S1 1AA">Collect in store</option>
              <option value="Account Address" data-address-line="<%= session[] %>">Use my address</option>
              <option value="">Use another address</option>
          </select>
      <% else %>
          <h3>Please log in to proceed</h3>
          <button onclick="toggleDropdownUser(event)" class="cart-page-log-in-button">Log In</button>
      <% end %>
    </div>
  </div>
