<div class="barista-page-body">
    <div class="barista-container">
        <h1 class="barista-title">Drink Queue</h1>
        
        <div class="barista-card-grid">
            <% if @pending_orders.empty? %>
                <div class="barista-empty">🎉 All caught up! No pending orders.</div>
            <% end %>

            <% @pending_orders.each do |order| %>
            <div class="barista-order-card">
                <div class="barista-card-header">
                    <span class="barista-order-id">Order #<%= order[:OrderID] %></span>
                    <span class="barista-order-time"><%= order[:CreatedAt].strftime("%H:%M") %></span>
                </div>

                <div class="barista-contents">
                    <% # Parsing the JSON string to display as a list %>
                    <% JSON.parse(order[:OrderContents]).each do |item, qty| %>
                        <div class="barista-item">
                            <span class="barista-qty"><%= qty %>x</span> <%= item %>
                        </div>
                    <% end %>
                </div>

                <div class="barista-footer">
                    <span class="barista-type <%= order[:OrderType].downcase %>">
                        <%= order[:OrderType] %>
                    </span>
                    
                    <form action="/order-management/barista" method="POST">
                        <input type="hidden" name="order_id" value="<%= order[:OrderID] %>">
                        <button type="submit" class="barista-complete-btn">Mark Done</button>
                    </form>
                </div>
            </div>
            <% end %>
        </div>
    </div>
</div>
