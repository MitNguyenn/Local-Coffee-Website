<div class="my-orders-container">
  <div class="my-orders-nav">
    <!-- IDs and onclick match the showTab function -->
    <button class="my-orders-nav-btn active" id="btn-open" onclick="showTab('open')">Open Tickets</button>
    <button class="my-orders-nav-btn" id="btn-resolved" onclick="showTab('resolved')">Resolved History</button>
  </div>

  <!-- OPEN TICKETS SECTION -->
  <div id="view-open" class="my-orders-section active">
    <% if @live_tickets.empty? %>
      <p class="m-dash-panel__title" style="text-align:center;">No active support tickets.</p>
    <% else %>
      <% @live_tickets.each do |ticket| %>
        <div class="my-orders-card ticket-border-open">
          <div class="my-orders-header">
            <span class="my-orders-title"><%= ticket[:TicketType] %></span>
            <span class="my-orders-date"><%= ticket[:CreatedAt].strftime("%d %b %H:%M") %></span>
          </div>
          <div class="my-orders-grid">
            <div class="ticket-content-text">
              <%= ticket[:TicketContent] %>
            </div>
            <div style="text-align: right;">
              <span class="ticket-id-tag">ID: #<%= ticket[:ticketID] %></span><br>
              <span class="my-orders-badge status-open">Pending</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- RESOLVED TICKETS SECTION -->
  <div id="view-resolved" class="my-orders-section">
    <% if @past_tickets.empty? %>
      <p class="m-dash-panel__title" style="text-align:center;">Your resolved history is empty.</p>
    <% else %>
      <% @past_tickets.each do |ticket| %>
        <div class="my-orders-card ticket-resolved-dim">
          <div class="my-orders-header">
            <span class="my-orders-title"><%= ticket[:TicketType] %></span>
            <span class="my-orders-date"><%= ticket[:CreatedAt].strftime("%d %b %Y") %></span>
          </div>
          <div class="my-orders-grid">
            <div class="ticket-content-text" style="color: #718096; font-style: italic;">
              <%= ticket[:TicketContent] %>
            </div>
            <div style="text-align: right;">
              <span class="ticket-id-tag">ID: #<%= ticket[:ticketID] %></span><br>
              <span class="my-orders-badge status-resolved">Resolved</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
function showTab(type) {
  // 1. Hide all sections
  document.querySelectorAll('.my-orders-section').forEach(s => s.classList.remove('active'));
  // 2. Show the selected section
  const selectedSection = document.getElementById('view-' + type);
  if (selectedSection) selectedSection.classList.add('active');
  
  // 3. Update button styling
  document.querySelectorAll('.my-orders-nav-btn').forEach(b => b.classList.remove('active'));
  const selectedBtn = document.getElementById('btn-' + type);
  if (selectedBtn) selectedBtn.classList.add('active');
}
</script>
