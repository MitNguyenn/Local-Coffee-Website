<div class="my-orders-container">
  <!-- TAB NAVIGATION -->
  <div class="my-orders-nav">
    <button class="my-orders-nav-btn active" id="btn-open" onclick="showTab('open')">
      Open Tickets (<%= @live_tickets.count %>)
    </button>
    <button class="my-orders-nav-btn" id="btn-resolved" onclick="showTab('resolved')">
      Resolved History
    </button>
  </div>

  <!-- OPEN TICKETS SECTION -->
  <div id="view-open" class="my-orders-section active">
    <% if @live_tickets.empty? %>
      <div class="my-orders-card" style="text-align: center; padding: 3rem;">
        <p class="m-dash-panel__title">No active support tickets.</p>
        <p style="color: #a0aec0; font-size: 0.9rem;">Need help? Contact our baristas in-store.</p>
      </div>
    <% else %>
      <% @live_tickets.each do |ticket| %>
        <div class="my-orders-card ticket-border-open">
          <div class="my-orders-header">
            <span class="my-orders-title"><%= ticket[:ticket_type] %></span>
            <span class="my-orders-date"><%= ticket[:created_at].strftime("%d %b %H:%M") %></span>
          </div>
          
          <div class="my-orders-grid">
            <div class="ticket-content-text">
              <%= ticket[:ticket_content].length > 100 ? ticket[:ticket_content][0..100] + "..." : ticket[:ticket_content] %>
            </div>
            
            <div style="text-align: right; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between;">
              <span class="ticket-id-tag">#ID: <%= ticket[:ticket_id] %></span>
              
              <!-- DYNAMIC DETAILS BUTTON -->
              <a href="/ticket/<%= ticket[:ticket_id] %>" class="view-details-btn">View Full Ticket</a>
              
              <span class="my-orders-badge status-open">Pending Review</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- RESOLVED TICKETS SECTION -->
  <div id="view-resolved" class="my-orders-section">
    <% if @past_tickets.empty? %>
      <div class="my-orders-card" style="text-align: center; padding: 3rem;">
        <p class="m-dash-panel__title">Your resolved history is empty.</p>
      </div>
    <% else %>
      <% @past_tickets.each do |ticket| %>
        <div class="my-orders-card ticket-resolved-dim">
          <div class="my-orders-header">
            <span class="my-orders-title" style="color: #718096;"><%= ticket[:ticket_type] %></span>
            <span class="my-orders-date"><%= ticket[:created_at].strftime("%d %b %Y") %></span>
          </div>
          
          <div class="my-orders-grid">
            <div class="ticket-content-text" style="color: #a0aec0; font-style: italic;">
              <%= ticket[:ticket_content].length > 80 ? ticket[:ticket_content][0..80] + "..." : ticket[:ticket_content] %>
            </div>
            
            <div style="text-align: right;">
              <span class="ticket-id-tag">#ID: <%= ticket[:ticket_id] %></span><br>
              <a href="/ticket/<%= ticket[:ticket_id] %>" class="view-details-btn" style="background: #718096;">View Archive</a><br>
              <span class="my-orders-badge status-resolved">Resolved</span>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
function showTab(type) {
  // 1. Remove active class from all sections and hide them
  const sections = document.querySelectorAll('.my-orders-section');
  sections.forEach(s => {
    s.classList.remove('active');
    s.style.display = 'none';
  });

  // 2. Show the specific section
  const targetSection = document.getElementById('view-' + type);
  if (targetSection) {
    targetSection.classList.add('active');
    targetSection.style.display = 'block';
  }
  
  // 3. Update button styling
  const buttons = document.querySelectorAll('.my-orders-nav-btn');
  buttons.forEach(b => b.classList.remove('active'));
  
  const targetBtn = document.getElementById('btn-' + type);
  if (targetBtn) {
    targetBtn.classList.add('active');
  }
}

// Initializing the view on load
window.onload = function() {
    showTab('open');
};
</script>
