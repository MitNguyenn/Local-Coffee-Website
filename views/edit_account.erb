<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin | Edit User</title>
</head>
<body>

  <main class="login-container">
    <div class="login-card" style="max-width: 500px;">
      
      <h1 class="acc-view__title" style="font-size: 2rem;">Edit Account</h1>
      <p style="margin-top: -20px; color: #a67458;">Updating User ID: <strong>#<%= @account[:user_id] %></strong></p>
      <form method="POST">

        <input type="reset">

        <h3 class="detail-header">Personal Details</h3>

        <div class="input-group">
          <label for="first_name">First Name</label>
          <input type="text" name="first_name" value="<%= @account[:first_name] %>" class="account-input">
        </div>

        <div class="input-group">
          <label for="last_name">Last Name</label>
          <input type="text" name="last_name" value="<%= @account[:last_name] %>" class="account-input">
        </div>

        <div class="input-group">
          <label for="Username">Reset Password</label>
          <input type="checkbox" name="reset_password" id="reset_password" style="margin-right: 10px;">
        </div>

        <h3 class="detail-header">Permissions & Contact</h3>
        
        <!-- ROLE SELECTION -->
      <div class="input-group">
        <label for="account_type">System Role</label>
        <select name="account_type" class="acc-view__search" style="width: 100%; border-radius: 8px; margin-bottom: 15px; appearance: auto; background-color: #fdf5e6;">
          <option value="customer" <%= 'selected' if @account[:account_type] == 'customer' %>>Customer</option>
          <option value="barista" <%= 'selected' if @account[:account_type] == 'barista' %>>Barista</option>
          <option value="manager" <%= 'selected' if @account[:account_type] == 'manager' %>>Manager</option>
          <option value="administrator" <%= 'selected' if @account[:account_type] == 'administrator' %>>Administrator</option>
        </select>
        </div>

        <div class="input-group">
          <label for="email">Email address</label>
          <input type="text" name="email" value="<%= @account[:email] %>" class="account-input">
        </div>

        <div class="input-group">
          <label for="phone_number">Phone Number</label>
          <input type="text" name="phone_number" value="<%= @account[:phone_number] %>" class="account-input">
        </div>

        <h3 class="detail-header">location</h3>
        
        <div class="input-group">
          <label for="address">Full address</label>
          <input type="text" name="address" value="<%= @account[:address] %>" class="account-input">
        </div>

        <div class="input-group">
          <label for="postcode">postcode</label>
          <input type="text" name="postcode" value="<%= @account[:postcode] %>" class="account-input">
        </div>

        <div style="margin-top: 30px; display: flex; gap: 10px;">
          <input type="submit" value="Save Changes" class="acc-view__btn" style="flex: 2; padding: 15px;">
          <a href="/manage-accounts" class="acc-view__btn" style="flex: 1; padding: 15px; background: #64748b;">Cancel</a>
        </div>
      </form>
      <div style="margin-top: 30px;">
        <a href="/manage-accounts-delete/<%= @account[:user_id] %>" class="acc-view__btn" style="padding: 15px; background: #64748b;">Delete Account</a>
      </div>
    </div>
  </main>

</body>
</html>
