<div class="page-title">
    <h2>Our Hot Drinks</h2>
</div>

<div class="catalog-grid" id="item-container">
  <% @drinks.each do |drink| %>
    <div class="product-card" data-drink-id="<%= drink.DrinkID %>" data-beverage="<%= drink.Beverage %>">
      <%
        rel_path = "drinks/#{drink.DrinkID}.png"
        
        if File.exist?(File.join(Dir.pwd, "public", rel_path))
          display_path = "/#{rel_path}"
        else
          display_path = "/drinks/drink_img_not_found.png"
        end
      %>
    
      <img src="<%= display_path %>" alt="<%= drink.Beverage %>">
      <h3><%= drink.Beverage %></h3>
      <p class="price">£<%= sprintf('%.2f', drink.Price) %></p>
      <button class="add-to-basket-button">Add to basket</button>
      <button class="buy-button">Buy</button>
    </div>
  <% end %>
</div>

<script>
  const container = document.getElementById('item-container');

  container.addEventListener('click', (event) => {
    if (event.target.classList.contains('add-to-basket-button')) {
      if (event.target.textContent == "Add to basket") {
        event.target.textContent = "Added! ✅";
        
        // do other stuff (actually add to the basket, update database, ...)
        setTimeout(() => { event.target.textContent = "Remove from basket"; }, 1000);
      } else {
        event.target.textContent = "Removed!";

        // do other stuff (remove from basket, update database, ...)
        setTimeout(() => { event.target.textContent = "Add to basket";}, 1000);
      }
     return; // Stop here so we don't redirect
    }
    const card = event.target.closest('.product-card');
    if (card) {
      const drinkID = card.dataset.drinkId;
      const bevName = encodeURIComponent(card.dataset.beverage);
      
      // window.location.href = `/product/?type=drink&bean_id=${card.dataset.beanId}&name=${bevName}`;
      // window.location.href = `/product/?type=drink&id=${drinkID}&name=${bevName}`;
      if (drinkID) {
        window.location.href = `/product/?type=drink&id=${drinkID}`;
      } else {
        console.error("Drink ID is missing from the HTML card!");
      }
    }
  });
</script>