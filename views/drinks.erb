<div class="page-title">
    <h2>Our Hot Drinks</h2>
</div>

<div class="catalog-grid" id="item-container">
  <% @drinks.each do |drink| %>
    <div class="product-card" data-drink-id="<%= drink.DrinkID %>">
      <%
        rel_path = "drinks/#{drink.DrinkID}.png"
        if File.exist?(File.join(Dir.pwd, "public", rel_path))
          display_path = "/#{rel_path}"
        else
          display_path = "/drinks/drink_img_not_found.png"
        end
      %>
    
      <img src="<%= display_path %>" alt="<%= drink.Beverage %>">
      <h3><%= drink.Beverage %></h3>
      <p class="price">£<%= sprintf('%.2f', drink.Price) %></p>
      <button class="add-to-basket-button">Add to basket</button>
      <button class="buy-button">Buy</button>
    </div>
  <% end %>
</div>

<script>
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', eventHandlerDrinkPage);
  } else {
    eventHandlerDrinkPage();
  }
</script>