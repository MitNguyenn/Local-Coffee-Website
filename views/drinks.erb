<div class="page-title">
    <h2>Our Hot Drinks</h2>
</div>

<div class="catalog-grid" id="item-container">
  <% @drinks.each do |drink| %>
    <div class="product-card" data-drink-id="<%= drink.DrinkID %>">
      <%
        rel_path = "drinks/#{drink.DrinkID}.png"
        if File.exist?(File.join(Dir.pwd, "public", rel_path))
          display_path = "/#{rel_path}"
        else
          display_path = "/drinks/drink_img_not_found.png"
        end
      %>
    
      <img src="<%= display_path %>" alt="<%= drink.Beverage %>">
      <h3><%= drink.Beverage %></h3>
      <p class="price">£<%= sprintf('%.2f', drink.Price) %></p>
      <button class="add-to-basket-button">Add to basket</button>
      <button class="buy-button">Buy</button>
    </div>
  <% end %>
</div>

<script>
  const container = document.getElementById('item-container');

  container.addEventListener('click', (event) => {
    const target = event.target;
    const card = target.closest('.product-card');
    
    if (!card) return;

    const drinkId = card.dataset.drinkId;

    if (target.classList.contains('add-to-basket-button')) {
      fetch('/add-to-basket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `id=${drinkId}&type=drink`
      })
      .then(response => response.json())
      .then(data => {
        const cartCount = document.getElementById('basket-count');
        if (cartCount) cartCount.textContent = data.count;
        
        target.textContent = "Added! ✅";
        setTimeout(() => { target.textContent = "Remove from basket"; }, 1000);
      });
      return;
    }
    
    if (target.classList.contains('buy-button')) {
      // Direct redirect is better for navigation [cite: 9, 25]
      window.location.href = `/checkout?id=${productId}&type=${productType}`;
    return;
    }

    if (card) {
      window.location.href = `/product/?type=drink&id=${drinkId}`;
    }
  });
</script>