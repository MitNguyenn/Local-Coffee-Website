<main class="acc-view__main">
  <h1 class="acc-view__title">Account Management</h1>

  <!-- Search Input -->
  <input type="text" id="accountSearch" class="acc-view__search" 
         onkeyup="filterTable()" placeholder="Search by name, email, or role...">

  <!-- Table Board -->
  <div class="acc-view__board">
    <table id="accountsTable" class="acc-view__table">
      <thead>
        <tr>
          <th class="acc-view__th">ID</th>
          <th class="acc-view__th">Full Name</th>
          <th class="acc-view__th">Email Address</th>
          <th class="acc-view__th">Phone Number</th>
          <th class="acc-view__th">Postcode</th>
          <th class="acc-view__th">Account Type</th>
          <th class="acc-view__th">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @grouped_accounts.each do |role, accounts| %>
          <% accounts.each do |account| %>
            <tr class="acc-view__row">
              <td class="acc-view__td">#<%= account[:UserID] %></td>
              <td class="acc-view__td"><%= account[:first_name] %> <%= account[:last_name] %></td>
              <td class="acc-view__td"><%= account[:email] %></td>
              <td class="acc-view__td"><%= account[:PhoneNumber] %></td>
              <td class="acc-view__td"><%= account[:Postcode] %></td>
              <td class="acc-view__td">
                <span class="acc-view__badge"><%= account[:AccountType] || role %></span>
              </td>
              <td class="acc-view__td">
                <!-- Keep original Edit Link -->
                <a href="/edit-account/<%= account[:UserID] %>" id="editaccount-<%= account[:UserID] %>" style="margin-right: 15px;">Edit Account</a>
                
                <!-- Added RESTful Delete Form using Method Overriding -->
                <form action="/delete-account/<%= account[:UserID] %>" method="post" style="display: inline;" onsubmit="return confirm('Are you sure you want to permanently delete this account?');">
                  <input type="hidden" name="_method" value="delete">
                  <button type="submit" style="color: #dc3545; background: none; border: none; padding: 0; font-family: inherit; font-size: inherit; cursor: pointer; text-decoration: underline;">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</main>

<script>
  function filterTable() {
    const filter = document.getElementById("accountSearch").value.toLowerCase();
    const rows = document.querySelectorAll(".acc-view__row");

    rows.forEach(row => {
      const isMatch = row.textContent.toLowerCase().includes(filter);
      row.style.display = isMatch ? "" : "none";
    });
  }
</script>
