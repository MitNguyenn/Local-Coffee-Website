<div class="product-detail-container">
  <h1 id="beverage" data-beverage="<%= @item.Beverage %>" ><%= @item.Beverage %></h1>
  <div class="product-main-content">
    <%
      rel_path = "drinks/#{@item.Beverage}.png"
      
      if File.exist?(File.join(Dir.pwd, "public", rel_path))
        display_path = "/#{rel_path}"
      else
        display_path = "/drinks/drink_img_not_found.png"
      end
    %>
    
    <img src="<%= display_path %>" alt="<%= @item.Beverage %>" width="500" height="500">
    <div class="product-details" id="product-details">
      <span id="base-price" data-price="<%= @item.RegularPrice %>" style="display:none;"></span>
      <p><%= @item.Description %></p>

      <label for="drink-size-select">Size:</label>
      <select name="drink-size" id="drink-size-select">
        <% @drink_sizes.each do | drink_size | %>
          <option value="<%= drink_size[:DrinkSize] %>" data-multiplier="<%= drink_size[:MarkupMultiplier] %>">
            <%= drink_size[:DrinkSize] %>
          </option>
        <% end %>
      </select>

      <label for="milk-type-select"><b>Milk types:</b></label>
      <% if @item.ContainsMilk %>
        <select name="milk-type" id="milk-type-select">
          <% @milk_types.each do | milk_type | %>
              <% if milk_type[:MilkType] == "Whole" %>
                <option value="<%= milk_type[:MilkType] %>" data-milk-price="0.0">
                  <%= milk_type[:MilkType] %> (+£0)
                </option>
              <% else %>
                <option value="<%= milk_type[:MilkType] %>" data-milk-price="<%= milk_type[:Price] %>">
                  <%= milk_type[:MilkType] %> (+£<%= milk_type[:Price] %>)
                </option>
              <% end %>
          <% end %>
        </select>
      <% else %>
        <select name="milk-type" id="milk-type-select">
          <option value="None" data-milk-price="0.0">
              Don't add milk
          </option>
          <% @milk_types.each do | milk_type | %>
            <option value="<%= milk_type[:MilkType] %>" data-milk-price="<%= milk_type[:Price] %>">
                <%= milk_type[:MilkType] %> (+£<%= milk_type[:Price] %>)
            </option>
          <% end %>
        </select>
      <% end %>

      <h2 id="display-price">Total price: £<%= sprintf("%.2f", @item.RegularPrice) %></h2>
      <button onclick="addToCartOnClick(event)" class="add-to-cart-button" id="add-to-cart-button">Add to Cart</button>
    </div> 
  </div> 
  <a href="/drinks">Back to Catalog</a>
</div>
 
<script>
  const beverage = document.getElementById('beverage').dataset.beverage;

  const basePriceValue = parseFloat(document.getElementById('base-price').dataset.price);
  const displayPrice = document.getElementById('display-price');

  const drinkSizeSelect = document.getElementById('drink-size-select');
  const milkTypeSelect = document.getElementById('milk-type-select');

  function getPrice() {
    const sizeOption = drinkSizeSelect.options[drinkSizeSelect.selectedIndex];
    const milkOption = milkTypeSelect.options[milkTypeSelect.selectedIndex];

    const multiplier = parseFloat(sizeOption.dataset.multiplier);
    const milkPrice = parseFloat(milkOption.dataset.milkPrice);

    return (basePriceValue * multiplier) + milkPrice;
  }

  function updatePrice() {
    newPrice = getPrice();
    displayPrice.innerText = 'Total price: £' + roundToTwoDecimalPlaces(newPrice);
  }

  drinkSizeSelect.addEventListener('change', updatePrice);
  milkTypeSelect.addEventListener('change', updatePrice);

  function addToCartOnClick(event) {
    const drinkSize = document.getElementById('drink-size-select').value;
    const milkType = document.getElementById('milk-type-select').value;
    const price = getPrice();

    fetch('/add-to-cart', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `item_type=drink&beverage=${beverage}&drink_size=${drinkSize}&milk_type=${milkType}&price=${price}`
    })
    .then(data => {
      const indicator = document.getElementById('cart-indicator');
      if (indicator) {
        indicator.classList.remove('hidden');
      }
      
      const button = document.getElementById('add-to-cart-button');
      button.textContent = "Added! ✅";
      setTimeout(() => { button.textContent = "Add to cart"; }, 1000);
    });
  }
</script>
