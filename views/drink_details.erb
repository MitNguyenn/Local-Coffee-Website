<div class="product-detail-container">
  <h1><%= @item.Beverage %></h1>
  <div class="product-main-content">
    <%
      rel_path = "drinks/#{@item.DrinkID}.png"
      
      if File.exist?(File.join(Dir.pwd, "public", rel_path))
        display_path = "/#{rel_path}"
      else
        display_path = "/drinks/drink_img_not_found.png"
      end
    %>
    
    <img src="<%= display_path %>" alt="<%= @item.Beverage %>" width="500" height="500">
    <div class="product-details" id="product-details">
      <p><%= @item.Description %></p>
      <div class = "product-properties">
        <div class="product-price">
          <p>Price: <strong>£<%= sprintf('%.2f', @item.Price) %></strong></p>
        </div><br>

        <label for="milk-type">Milk Type: </label>
        <select name="milk-type">
          <option value="whole">Whole</option>
          <option value="oat">Oat</option>
          <option value="soy">Soy</option>
        </select><br><br>

        <label for="size">Size</label>
        <select name="size">
          <option value="regular">Regular</option>
          <option value="large">Large &#40;&#43;&#163; 1.00&#41;</option>
        </select><br><br>

      </div>
      <button class="add-to-basket-button" data-id="<%= @item.DrinkID %>">Add to Basket</button>
      <button class="buy-button">Buy Now</button>
    </div> 
  </div> 
  <a href="/drinks">Back to Catalog</a>
</div>

<script>
  const container = document.getElementById('product-details');
  const sizeSelect = document.querySelector('select[name="size"]');
  const priceEl = document.querySelector('.product-price p');
  const basePrice = <%= @item.Price %>;

  container.addEventListener('click', (event) => {
    if (event.target.classList.contains('add-to-basket-button')) {
      const drinkID = event.target.dataset.drinkId;
      const size = document.querySelector('select[name="size"]').value;
      
      if (event.target.textContent == "Add to Basket") {
        console.log("Debug: Added " + drinkID + " to basket.")
        event.target.textContent = "Added! ✅";
          
        setTimeout(() => { event.target.textContent = "Add to basket"; }, 1000);
      } else {
        console.log("Debug: Removed " + drinkID + " from basket.")
        event.target.textContent = "Added! ✅";

        setTimeout(() => { event.target.textContent = "Add to basket";}, 1000);
      }
     return; // Stop here so we don't redirect
    }

    if (event.target.classList.contains('buy-button')) {
      const drinkId = document.querySelector('.add-to-basket-button').dataset.id;
      const size = document.querySelector('select[name="size"]').value;
      fetch('/add-to-basket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `id=${drinkId}&type=drink&size=${size}`
      })
      .then(() => {
        window.location.href = '/checkout';
      });
      return;
    } 
  });
  sizeSelect.addEventListener('change', () => {
    const extra = sizeSelect.value === 'large' ? 1.00 : 0.00;
    const total = basePrice + extra;
    priceEl.innerHTML = `Price: <strong>£${total.toFixed(2)}</strong>`;
  });
</script>