
<!DOCTYPE html>
<html>
<head>
    <title>Secure Payment Provider</title>
    <meta http-equiv="refresh" content="3;url=/payment-callback?status=<%= @payment_status %>&order_id=<%= @order_id %>">
    <style>
        body { font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; background: #f4f4f9; }
        .loader-box { background: white; padding: 40px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); text-align: center; }
        .spinner { border: 4px solid #f3f3f3; border-top: 4px solid #5a31f4; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 20px auto; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="loader-box">
        <img src="/mastercard.svg" width="100"> <h2>Redirecting to Secure Payment...</h2>
        <div class="spinner"></div>
        <p>Please do not refresh the page.</p>
    </div>
</body>
</html>