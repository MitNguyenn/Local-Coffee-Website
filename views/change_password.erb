<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Change Password</title>
    <link rel="stylesheet" href="style.css">
    
  </head>
  <body>

    <main class="login-container">
  <div class="login-card">
    <h2>Change Password</h2>
      <form method="POST" action="/change-password" >
      
      <div class="input-wrapper">
        <label for="password1">CreatePassword</label>
        <input type="password" 
        id="password1" 
        name="password1" 
        class="account-input" required>
        <img src="eye-crossed.png"
          class="reveal-password"
          onclick="togglePassword(this)">
      </div>

      <div class="input-wrapper">
        <label for="password2">Confirm Password</label>
        <input type="password" 
        id="password2" 
        name="password2" 
        class="account-input" required>
        <img src="eye-crossed.png"
          class="reveal-password"
          onclick="togglePassword(this)">
      </div>

      <div id="error-message" class="error-message"></div>

      <button type="submit" id="confirm-button" class="login-btn" disabled>Confirm</button>
    </form>

  </div>
</main>
  <script>
    function togglePassword(icon) {
      const wrapper = icon.parentElement;
      const input = wrapper.querySelector('input');

      if (input.type === "password") {
        input.type = "text";
        icon.src = "eye-open.png";
      } else {
        input.type = "password";
        icon.src = "eye-crossed.png";
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const password1Input = document.getElementById('password1');
      const password2Input = document.getElementById('password2');
      const errorDiv = document.getElementById('error-message');
      const confirmButton = document.getElementById('confirm-button');

      function validatePasswords() {

      confirmButton.disabled = true;

        if (password2Input.value === "") {
          errorDiv.textContent = "";
          return ;
        }
        if (password1Input.value !== password2Input.value) {
          errorDiv.textContent = "Passwords do not match!";
          errorDiv.style.color = "red";
          confirmButton.disabled = true;
        }
        else {
          errorDiv.textContent = "Passwords match!";
          errorDiv.style.color = "green";
          confirmButton.disabled = false;
        }
        
      }

      password1Input.addEventListener('input', validatePasswords);
      password2Input.addEventListener('input', validatePasswords);
    });
  </script>
  </body>
</html>