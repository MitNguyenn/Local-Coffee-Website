<!DOCTYPE html>
<html>
<head>
  <title>Account Management</title>
</head>
<body>
  <h1>Account Management</h1>
  <input type="text" id="accountSearch" onkeyup="filterTable()" placeholder="Search by name, email, ID, or type...">
  <table id="accountsTable">
    <thead>
      <tr>
        <th>UserID</th>
        <th>First Name</th>
        <th>Last Name</th>
        <th>Email</th>
        <th>Phone Number</th>
        <th>Postcode</th>
        <th>Account Type</th>
      </tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr>
          <!-- Using hash bracket notation to fix the "undefined method" error -->
          <td><%= account[:UserID] %></td>
          <td><%= account[:FirstName] %></td>
          <td><%= account[:LastName] %></td>
          <td><%= account[:email] %></td>
          <td><%= account[:PhoneNumber] %></td>
          <td><%= account[:Postcode] %></td>
          <td><%= account[:AccountType] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <script>
    function filterTable() {
      const input = document.getElementById("accountSearch");
      const filter = input.value.toLowerCase();
      const table = document.getElementById("accountsTable");
      const tr = table.getElementsByTagName("tr");


      for (let i = 1; i < tr.length; i++) {
        const rowText = tr[i].textContent.toLowerCase();
        if (rowText.includes(filter)) {
          tr[i].style.display = "";
        } else {
          tr[i].style.display = "none";
        }
      }
    }
  </script>
</body>
</html>
