<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Account Settings</title>
    <link rel="stylesheet" href="/style.css">

  </head>
  <body>

  <main class="login-container">
    <div class="login-card">
      
      <h2>Hi, <%= @user[:first_name]%> </h2>
      <% if @account_flagged %>
        <p style="color: red;">Your account has been flagged for inactivity.</p>
      <% end %>
      <h3 class="detail-header">Personal Details</h3>

      <form method="POST" action="/update-account">
        <div class="input-wrapper">
        <label for="first_name">First Name</label>
          <input type="text" name = "first_name" value="<%= @user[:first_name] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="last_name">Last Name</label>
          <input type="text" name = "last_name" value="<%= @user[:last_name] %>" class="account-input">
        </div>

        <h3 class="detail-header">Account Details</h3>
        
        <div class="input-wrapper">
        <label for="email">Email</label>
          <input type="text" name = "email" value="<%= @user[:email] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="password">Password</label>
          <input type="password" name = "password_placeholder" value="••••••••••••" class="account-input">
        </div>

        <div class="extra-links">
          <a href="/change-password">Change password</a>
        </div>

        <h3 class="detail-header">Address Details</h3>
        
        <div class="input-wrapper">
        <label for="address">address</label>
          <input type="text" name="address" value="<%= @user[:address] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="postcode">Postcode</label>
          <input type="text" name = "postcode" value="<%= @user[:postcode] %>" class="account-input">
        </div>
        <br>
        <br>
        <input type = "submit" value="Submit" class = "submit-btn">
      </form>

      <form method="POST" action="/delete-account" onsubmit="return confirm('Are you sure you want to delete your account? This action cannot be undone.');" style="margin-top: 15px;">
        <input type="submit" value="Delete Account" class="delete-btn" style="background-color: #ff4d4d; color: white; border: none; padding: 10px 20px; cursor: pointer; border-radius: 4px;">
      </form>

      <% if params[:success] %>
        <p style="color: green;">Profile updated successfully!</p>
      <% end %>
      <% if params[:error] == 'email_taken' %>
        <p style="color: red;">The email address is already in use by another account.</p>
      <% end %>
     </div>
  </main>
  </body>
</html>