<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Account Settings</title>
    <link rel="stylesheet" href="/style.css">

  </head>
  <body>

  <main class="login-container">
    <div class="login-card">
      
      <h2>Hi, <%= @first_name %> </h2>

      <h3 class="detail-header">Personal Details</h3>

      <form method="POST" action="/update-account">
        <div class="input-wrapper">
        <label for="firstname">First Name</label>
          <input type="text" value="<%= @first_name %>" 
          readonly class="account-input">
          <img src="edit.png"
          class="edit-icon"
          onclick="enableEdit(this)">
        </div>

        <div class="input-wrapper">
        <label for="lastname">Last Name</label>
          <input type="text" value="<%= @last_name %>" 
          readonly class="account-input">
          <img src="edit.png"
          class="edit-icon"
          onclick="enableEdit(this)">
        </div>

        <div class="input-wrapper">
        <label for="date">Date of Birth</label>
          <input type="text" value="<%= @date_of_birth %>"
          readonly class="account-input">
          <img src="edit.png"
          class="edit-icon"
          onclick="enableEdit(this)">
        </div>

        <h3 class="detail-header">Account Details</h3>
        
        <div class="input-wrapper">
        <label for="email">Email</label>
          <input type="text" value="<%= @email %>" 
          readonly class="account-input">
          <img src="edit.png"
          class="edit-icon"
          onclick="enableEdit(this)">
        </div>

        <div class="input-wrapper">
        <label for="password">Password</label>
          <input type="password" value="<%= @password %>" 
          readonly class="account-input">
          <img src="eye-crossed.png"
          class="reveal-password"
          onclick="togglePassword(this)">
        </div>

        <div class="extra-links">
          <a href="/change-password">Change password</a>
        </div>

        <h3 class="detail-header">Address Details</h3>
        
        <div class="input-wrapper">
        <label for="address">Address</label>
          <input type="text" value="<%= @address %>" 
          readonly class="account-input" caret-color=transparent>
          <img src="edit.png"
          class="edit-icon"
          onclick="enableEdit(this)">
        </div>

        <div class="input-wrapper">
        <label for="postcode">Postcode</label>
          <input type="text" value="<%= @postcode %>" 
          readonly class="account-input" caret-color=transparent>
          <img src="edit.png"
          class="edit-icon"
          onclick="enableEdit(this)">
        </div>

      </form>
     </div>
  </main>
  <script>
    function enableEdit(icon) {
      const input = icon.previousElementSibling;
      if (input.hasAttribute('readonly')) {
        input.removeAttribute('readonly');
        input.focus();
        icon.src = 'check.png';
      } else {
        input.setAttribute('readonly', true);
        icon.src = 'edit.png';
      }
    }

    function togglePassword(icon) {
      const wrapper = icon.parentElement;
      const input = wrapper.querySelector('input');

      if (input.type === "password") {
        input.type = "text";
        icon.src = "eye-open.png";
      } else {
        input.type = "password";
        icon.src = "eye-crossed.png";
      }
      }
  </script>
  </body>
</html>

