<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Account Settings</title>
    <link rel="stylesheet" href="/style.css">

  </head>
  <body>

  <main class="login-container">
    <div class="login-card">
      
      <h2>Hi, <%= @user[:FirstName]%> </h2>

      <h3 class="detail-header">Personal Details</h3>

      <form method="POST" action="/update-account">
        <div class="input-wrapper">
        <label for="firstname">First Name</label>
          <input type="text" name = "FirstName" value="<%= @user[:FirstName] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="lastname">Last Name</label>
          <input type="text" name = "LastName" value="<%= @user[:LastName] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="date">Date of Birth</label>
          <input type="date" name = "Date_of_birth" value="<%= @user[:Date_of_birth] ? @user[:Date_of_birth].to_date : '' %>" class="account-input">
        </div>

        <h3 class="detail-header">Account Details</h3>
        
        <div class="input-wrapper">
        <label for="email">Email</label>
          <input type="text" name = "email" value="<%= @user[:email] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="password">Password</label>
          <input type="password" name = "password_placeholder" value="••••••••••••" class="account-input">
        </div>

        <div class="extra-links">
          <a href="/change-password">Change password</a>
        </div>

        <h3 class="detail-header">Address Details</h3>
        
        <div class="input-wrapper">
        <label for="address">Address</label>
          <input type="text" name="Address" value="<%= @user[:Address] %>" class="account-input">
        </div>

        <div class="input-wrapper">
        <label for="postcode">Postcode</label>
          <input type="text" name = "Postcode" value="<%= @user[:Postcode] %>" class="account-input">
        </div>
        <br>
        <br>
        <input type = "submit" value="Submit" class = "submit-btn">
      </form>
      <% if params[:success] %>
  <p style="color: green;">Profile updated successfully!</p>
<% end %>
     </div>
  </main>
  </body>
</html>

